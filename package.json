{
    "name": "exam-seating-system",
    "version": "1.0.0",
    "description": "Production-ready Exam Seating Arrangement System with rule-based allocation engine",
    "main": "server/index.js",
    "scripts": {
        "start": "node server/index.js",
        "dev": "concurrently \"nodemon server/index.js\" \"cd client && npm start\"",
        "dev:server": "nodemon server/index.js",
        "dev:client": "cd client && npm start",
        "seed": "node server/scripts/seed.js",
        "migrate": "node server/scripts/migrate.js",
        "import": "node server/scripts/importXlsx.js",
        "test": "jest --config jest.config.js"
    },
    "dependencies": {
        "better-sqlite3": "^11.7.0",
        "cors": "^2.8.5",
        "exceljs": "^4.4.0",
        "express": "^4.21.0",
        "pdfkit": "^0.15.0",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "concurrently": "^9.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.0"
    }
}